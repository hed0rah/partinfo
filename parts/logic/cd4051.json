    "extra": {
      "function": "1-of-8 analog mux/demux, bidirectional channels",
      "logic family": "CD40xx CMOS (4000B)",
      "channels": 8,
      "address": "A (LSB), B, C (MSB); ABC=000->CH0 ... 111->CH7",
      "inhibit": "active HIGH",
