      "function": "1-of-16 analog mux/demux, bidirectional channels",
      "logic family": "CD40xx CMOS (4000B)",
      "channels": 16,
      "address": "A (LSB), B, C, D (MSB); 4-bit binary select, 0000->CH0 ... 1111->CH15",
      "inhibit": "active HIGH",
      "Ron": "125 ohm typ over a 15Vpp signal range at VDD-VSS=15V (channel matching: 5 ohm typ)",
      "channel_leakage": "+-10pA typ OFF-state at VDD-VSS=10V",
      "Idd_quiescent": "0.2uW typ power dissipation at VDD-VSS=10V (i.e. negligible static current)"
    }
  },
  "typical_application": "Routing one of sixteen analog or digital signals into a single line, e.g. selecting between many I/O pins or sensor lines with a shared ADC/logic input. Used as the buffered I/O multiplexer on the Bus Pirate 5.",
  "gotchas": [
    "16 channels need a 4-bit address (A/B/C/D) versus the CD4051's 3-bit (8 channels); do not reuse CD4051 control wiring unmodified",
    "INHIBIT (pin 15) is active HIGH; tie LOW to enable the mux, do not float",
    "channels are bidirectional analog switches (Ron ~125 ohm), not buffered outputs; signals must stay between VSS and VDD",
    "TSSOP-24, SOIC-24, and PDIP-24 packages share the same pin numbering per TI's datasheet"
  ],
