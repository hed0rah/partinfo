    "brown-black-red-gold = 1,0 x100 = 1000 ohm = 1k, +/-5%.",
    "yellow-violet-orange-gold = 4,7 x1k = 47k, +/-5%.",
    "5-band brown-black-black-brown-brown = 1,0,0 x10 = 1000 ohm = 1k, +/-1%."
  ],
  "gotchas": [
    "the tolerance band (gold/silver, or brown/red on precision parts) is slightly separated; read from the opposite end",
